{
  "name": "pixeldesk",
  "version": "1.0.0",
  "description": "A retro pixel-art file organizer",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "com.pixeldesk.app",
    "productName": "PixelDesk",
    "files": ["dist/**/*", "package.json"],
    "win": { "target": "nsis" }
  }
}
